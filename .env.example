# HelPhone Environment Variables
# ================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control — it is in .gitignore.
#
# ONBOARDING NOTE:
# The VITE_* vars are read by the browser bundle at build time (Vite replaces them).
# The non-VITE_* vars are read by the Node server at runtime.
#
# Quick start for newcomers:
#   cp .env.example .env
#   # Set VITE_MAPBOX_TOKEN (required for maps)
#   # Leave VITE_AEGIS_VAULT_ID and VITE_ZK_PROVER_URL as-is for local dev
#   npm run dev

# ── Frontend (browser) ──────────────────────────────────────────────────────
# Mapbox token — required for the CommunityMap and WebGPUMap components.
# Get a free public token at https://account.mapbox.com/
# Without this, the map will not render. Other features work fine.
VITE_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJleGFtcGxlIn0.example

# Aegis Vault contract ID — the deployed Soroban aegis_vault contract address.
# For local dev, run `scripts/deploy-local-contract.sh` and paste the output here.
# Leave empty to run in mock mode (no on-chain interaction).
VITE_AEGIS_VAULT_ID=

# DAO contract ID — deployed helphone_dao contract address.
# Leave empty for local dev (mock mode).
VITE_HELPHONE_DAO_ID=

# ZK prover endpoint — where the backend ZK route is mounted.
# Default (/zk) works for local dev (server runs on PORT below).
# For production: https://your-domain.com/zk
VITE_ZK_PROVER_URL=/zk

# Enables the BLE proximity relay prototype (src/lib/bleRelay.ts). Off by default; not wired into the app yet.
VITE_BLE_GOSSIP=false

# ── Server (Node) ────────────────────────────────────────────────────────────
# Node environment (development/production/test)
NODE_ENV=development

# Server port — Vite dev proxy forwards /api and /zk to this port.
PORT=3001

# Passkeys — use the production hostname and origin when enabling WebAuthn.
PASSKEY_RP_ID=localhost
PASSKEY_ORIGIN=http://localhost:3000
PASSKEY_RP_NAME=HelPhone

# Session secret — must be at least 32 random characters in production.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-characters

# ── Database ─────────────────────────────────────────────────────────────────
# Postgres connection string.
# Local: start Postgres, then: createdb helphone
DATABASE_URL=postgresql://user:password@localhost:5432/helphone

# ── Stellar ──────────────────────────────────────────────────────────────────
# Stellar secret key for the server-side signing account.
# For testnet: generate at https://laboratory.stellar.org/#account-creator
STELLAR_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STELLAR_NETWORK=testnet

# ── Optional services ────────────────────────────────────────────────────────
# Supabase (optional — only needed if using Supabase instead of direct Postgres)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-key

# Redis (optional — only needed for multi-process WebSocket cluster)
# Leave empty to use in-process pub/sub (fine for single-node dev)
REDIS_URL=

# Logging level: error | warn | info | debug
LOG_LEVEL=info
