# HelPhone — Environment template
# Copy to .env and fill values. Never commit .env itself.

# ── Stellar ───────────────────────────────────────────────────────
VITE_HELPHONE_CONTRACT_ID=CDP5XZ7UYCGSQBYRDYM2OEAUQJULBZPULSQXK7LGNAJTRXRG3VHZLSHY
VITE_STELLAR_NETWORK=testnet
VITE_STELLAR_TESTNET_RPC_URL=https://soroban-testnet.stellar.org
VITE_STELLAR_TESTNET_HORIZON_URL=https://horizon-testnet.stellar.org
VITE_AEGIS_VAULT_ID=
VITE_MAINTAINER_VAULT_CONTRACT_ID=
VITE_ZK_PROVER_URL=https://helphone.onrender.com
VITE_MAPBOX_TOKEN=pk.ey...
VITE_EVENTS_URL=http://localhost:3001/events/stream

# ── Prover Server ─────────────────────────────────────────────────
PORT=3001
DATABASE_URL=postgres://user:pass@localhost:5432/helphone
PG_MAX_CONNECTIONS=20
PG_IDLE_TIMEOUT_MS=30000
COMPRESSION_THRESHOLD=1024
DEBUG_POOL=false
DEBUG_COMPRESSION=false

# ── CORS — Stateful Origin Validation & Preflight Caching ──────────
# Comma-separated list of allowed origins. Each entry is evaluated as a regex pattern:
#   - Exact: https://helphone.com
#   - Regex: https://.*\.helphone\.com  (matches any subdomain)
#   - Wildcard: https://*.helphone.com  (converted to .* internally)
# Preflight requests are cached for 86400 seconds (24h) via Access-Control-Max-Age.
# Example: ALLOWED_ORIGINS="https://helphone.com,https://staging.helphone.com,https://.*\\.helphone\\.com"
ALLOWED_ORIGINS=https://helphone.com,https://staging.helphone.com
CORS_MAX_AGE=86400

# ── Misc ──────────────────────────────────────────────────────────
RATE_LIMIT_MAX=60
WEB_CONCURRENCY=
NODE_ENV=development
