        <button
          aria-label="Switch language to English"
          aria-pressed="true"
          style="padding: 5px 9px; border-radius: 7px; border: 1px solid rgba(255, 255, 255, 0.3); background: rgba(255, 255, 255, 0.12); color: rgba(242, 236, 220, 0.95); font-size: 11px; font-weight: 700; letter-spacing: 0px; cursor: default; transition: all 0.15s;"
          type="button"
        >
          EN
        </button>
        <button
          aria-label="Switch language to Arabic"
          aria-pressed="false"
          style="padding: 5px 9px; border-radius: 7px; border: 1px solid rgba(255, 255, 255, 0.1); background: transparent; color: rgba(242, 236, 220, 0.45); font-size: 11px; font-weight: 700; letter-spacing: 0px; cursor: pointer; transition: all 0.15s;"
          type="button"
        >
          العربية
        </button>
      </div>
    </div>
  </nav>
  <section
    style="padding-top: 6rem; padding-bottom: 4rem; text-align: center;"
  >
    <h1
      style="color: rgb(236, 224, 204); margin-bottom: 1rem;"
    >
      Community Emergency Response Web App
    </h1>
    <p
      style="font-size: 1.25rem; color: rgb(162, 165, 134); max-width: 700px; margin: 0px auto 2rem; padding: 0px 1rem;"
    >
      Peer-to-peer decentralised emergency dispatch powered by Soroban smart contracts, ZK privacy proofs, and WebAuthn Passkeys.
    </p>
  </section>
</div>
`;

